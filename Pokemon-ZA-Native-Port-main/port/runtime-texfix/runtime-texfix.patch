diff -ruN a/runtime/nvn/vulkan/za_texguard_r28a.h b/runtime/nvn/vulkan/za_texguard_r28a.h
--- a/runtime/nvn/vulkan/za_texguard_r28a.h	1970-01-01 02:00:00.000000000 +0200
+++ b/runtime/nvn/vulkan/za_texguard_r28a.h	2026-10-30 14:50:09.346198081 +0200
@@ -0,0 +1,86 @@
+// r28a texfix (port/runtime-texfix): the [za-texguard] reports. A finalized (or never initialized) texture that reaches
+// the runtime is refused where it arrives - never registered, drawn into, copied, presented or uploaded to - and
+// reported here: the first time per (site, caller) as a klog line, every time in a counter, the counters once every
+// ZA_TG_SUMMARY_FRAMES presented frames when they changed. Nothing here runs unless a stale texture shows up (the
+// per-frame hook returns on one load while there were none).
+// Included once by textures.c (after nvn.h); host-tested (port/runtime-texfix/test) with LOG / frame stand-ins.
+#pragma once
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#ifndef ZA_TG_LOG
+#define ZA_TG_LOG(...) LOG(__VA_ARGS__)
+#endif
+#ifndef ZA_TG_FRAME
+#define ZA_TG_FRAME() vk_frame_counter()
+#endif
+#define ZA_TG_SUMMARY_FRAMES 1800  // (one minute at 30 fps)
+#define ZA_TG_MAX_SEEN 64
+
+static const char *const za_tg_names[ZA_TG_SITES] = {
+    [ZA_TG_REGISTER] = "register",              // textures.c tex_backend: a backend asked for a dead texture
+    [ZA_TG_SET_RT] = "set-render-targets",      // exec.c: a recorded SetRenderTargets names a dead texture
+    [ZA_TG_PASS] = "render-pass",               // exec.c begin_pass: a bound target is dead (state not cleared?)
+    [ZA_TG_CLEAR_TEXTURE] = "clear-texture",    // exec.c CMD_CLEAR_TEXTURE
+    [ZA_TG_COPY_TO_TEX] = "copy-buffer-to-texture",
+    [ZA_TG_COPY_FROM_TEX] = "copy-texture-to-buffer",
+    [ZA_TG_COPY_TEX] = "copy-texture",
+    [ZA_TG_PRESENT] = "present",                // device.c backend_present / backend_represent
+    [ZA_TG_UPLOAD_RGBA] = "video-upload",       // textures.c renderer_upload_rgba (video thread)
+    [ZA_TG_POOL_REGISTER] = "pool-register",    // objects.c nvnTexturePoolRegisterTexture / Image
+    [ZA_TG_FINALIZE_AGAIN] = "finalize-again",  // objects.c nvnTextureFinalize on a texture finalized before
+    [ZA_TG_LIVE_LIST] = "live-list",            // za_texlive_r28a.h: a backend's slot did not hold it (repaired)
+};
+
+static pthread_mutex_t za_tg_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct { int site; const void *caller; } za_tg_seen[ZA_TG_MAX_SEEN];
+static int za_tg_nseen;
+static uint64_t za_tg_count[ZA_TG_SITES], za_tg_reported[ZA_TG_SITES];
+static uint64_t za_tg_total;  // (read without the lock by the per-frame hook: atomics)
+
+// detail: the texture's guard word (live-list: the backend's reg); caller: a return address or NULL (the site says it)
+void za_texguard_hit(int site, const void *tex, uint32_t detail, const void *caller) {
+    if (site < 0 || site >= ZA_TG_SITES) site = ZA_TG_REGISTER;
+    bool first = true;
+    pthread_mutex_lock(&za_tg_lock);
+    za_tg_count[site]++;
+    __atomic_add_fetch(&za_tg_total, 1, __ATOMIC_RELAXED);
+    for (int i = 0; i < za_tg_nseen; i++)
+        if (za_tg_seen[i].site == site && za_tg_seen[i].caller == caller) { first = false; break; }
+    if (first && za_tg_nseen < ZA_TG_MAX_SEEN) {
+        za_tg_seen[za_tg_nseen].site = site;
+        za_tg_seen[za_tg_nseen].caller = caller;
+        za_tg_nseen++;
+    } else {
+        first = false;  // (seen, or the table is full: counted only)
+    }
+    pthread_mutex_unlock(&za_tg_lock);
+    if (!first) return;
+    if (site == ZA_TG_LIVE_LIST)
+        ZA_TG_LOG("[za-texguard] live-list: texture %p - its backend %p (reg %u) was not in its slot; repaired by a "
+                  "scan (frame %llu)\n", tex, caller, (unsigned)detail, (unsigned long long)ZA_TG_FRAME());
+    else
+        ZA_TG_LOG("[za-texguard] %s: texture %p is not live (guard %08x: %s) - skipped, never registered (caller %p, "
+                  "frame %llu)\n", za_tg_names[site], tex, (unsigned)detail,
+                  detail == NVN_TEX_DEAD ? "finalized" : "unknown / reused memory", caller,
+                  (unsigned long long)ZA_TG_FRAME());
+}
+
+// Once per presented frame (device.c): every ZA_TG_SUMMARY_FRAMES frames, the counters - if any changed.
+void za_texguard_frame(uint64_t frame) {
+    if (!__atomic_load_n(&za_tg_total, __ATOMIC_RELAXED) || frame % ZA_TG_SUMMARY_FRAMES) return;
+    char line[512];
+    int n = 0;
+    bool changed = false;
+    pthread_mutex_lock(&za_tg_lock);
+    for (int s = 0; s < ZA_TG_SITES; s++) {
+        if (za_tg_count[s] != za_tg_reported[s]) changed = true;
+        za_tg_reported[s] = za_tg_count[s];
+        if (za_tg_count[s] && n >= 0 && n < (int)sizeof line)
+            n += snprintf(line + n, sizeof line - (size_t)n, " %s=%llu", za_tg_names[s], (unsigned long long)za_tg_count[s]);
+    }
+    pthread_mutex_unlock(&za_tg_lock);
+    if (changed) ZA_TG_LOG("[za-texguard] counts at frame %llu:%s\n", (unsigned long long)frame, line);
+}
diff -ruN a/runtime/nvn/vulkan/za_texlive_r28a.h b/runtime/nvn/vulkan/za_texlive_r28a.h
--- a/runtime/nvn/vulkan/za_texlive_r28a.h	1970-01-01 02:00:00.000000000 +0200
+++ b/runtime/nvn/vulkan/za_texlive_r28a.h	2026-10-30 14:50:09.334198123 +0200
@@ -0,0 +1,106 @@
+// r28a texfix (port/runtime-texfix): textures.c's list of live game textures, consistent under a lock of its own.
+//
+// r28-play crashed in live_remove (backend_texture_destroyed, called by nvnTextureFinalize under exec_lock):
+//     ((TexBackend *)g_live[g_nlive - 1]->backend)->reg = b->reg;      with ->backend == 0x2 (fault address 0xa2)
+// The list's last entry was an NvnTexture that had been finalized and freed (its memory since reused), either
+// registered again through a stale pointer (tex_backend on a texture the executor's state, a recorded command list or
+// the present path still held) or left behind by an unsynchronised add / remove (the present path registered textures
+// without exec_lock). Here:
+//   - each entry is a pair: the texture and its backend, the backend's reg being its slot + 1. Maintenance only ever
+//     dereferences the backends (textures.c allocates and frees them), never a texture entry: a stale texture pointer
+//     in the list can no longer be followed by add / remove / pop;
+//   - every change and every walk holds za_live_lock (changes happen when a texture gets its backend or loses it,
+//     never per draw);
+//   - remove checks that the backend's slot really holds it; a mismatch is reported ([za-texguard] live-list, once)
+//     and repaired by a scan instead of swapping a wrong entry into place.
+// Host-tested under ASan / UBSan / TSan (port/runtime-texfix/test). Included once by textures.c, after NvnTexture and
+// TexBackend are defined and za_texguard_hit is declared (nvn.h).
+#pragma once
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdlib.h>
+
+static pthread_mutex_t za_live_lock = PTHREAD_MUTEX_INITIALIZER;
+static NvnTexture **g_live;    // the textures - identification only, never dereferenced in this file
+static TexBackend **g_live_b;  // their backends: g_live_b[i]->reg == i + 1
+static int g_nlive, g_cap_live;
+
+// false: no memory for a bigger list (the backend works, unlisted: b->reg 0; a reboot would not release it)
+static bool za_live_add(NvnTexture *t, TexBackend *b) {
+    bool ok = true;
+    pthread_mutex_lock(&za_live_lock);
+    if (g_nlive == g_cap_live) {
+        int cap = g_cap_live ? g_cap_live * 2 : 1024;
+        NvnTexture **nt = realloc(g_live, (size_t)cap * sizeof *nt);
+        if (nt) g_live = nt;
+        TexBackend **nb = nt ? realloc(g_live_b, (size_t)cap * sizeof *nb) : NULL;
+        if (nb) g_live_b = nb, g_cap_live = cap;  // (both grown, or the capacity stays: the next add tries again)
+        else ok = false;
+    }
+    if (ok) {
+        g_live[g_nlive] = t;
+        g_live_b[g_nlive] = b;
+        b->reg = ++g_nlive;
+    } else {
+        b->reg = 0;
+    }
+    pthread_mutex_unlock(&za_live_lock);
+    return ok;
+}
+
+// The entry of b goes; the last entry takes its slot. b->reg 0: not listed (nothing to do).
+static void za_live_remove(NvnTexture *t, TexBackend *b) {
+    pthread_mutex_lock(&za_live_lock);
+    int i = -1;
+    if (b->reg) {
+        i = b->reg - 1;
+        if (i < 0 || i >= g_nlive || g_live_b[i] != b || g_live[i] != t) {
+            za_texguard_hit(ZA_TG_LIVE_LIST, t, (uint32_t)b->reg, (const void *)b);
+            i = -1;
+            for (int k = 0; k < g_nlive; k++)
+                if (g_live_b[k] == b) { i = k; break; }
+        }
+    }
+    if (i >= 0) {
+        int last = --g_nlive;
+        if (i != last) {
+            g_live[i] = g_live[last];
+            g_live_b[i] = g_live_b[last];
+            g_live_b[i]->reg = i + 1;  // (a backend of this file: the only dereference the swap needs)
+        }
+        g_live[last] = NULL;
+        g_live_b[last] = NULL;
+    }
+    b->reg = 0;
+    pthread_mutex_unlock(&za_live_lock);
+}
+
+// Reboot (vk_textures_reset): the last entry, taken out of the list; false when the list is empty.
+static bool za_live_pop(NvnTexture **t, TexBackend **b) {
+    pthread_mutex_lock(&za_live_lock);
+    bool any = g_nlive > 0;
+    if (any) {
+        int last = --g_nlive;
+        *t = g_live[last];
+        *b = g_live_b[last];
+        g_live[last] = NULL;
+        g_live_b[last] = NULL;
+        (*b)->reg = 0;
+    }
+    pthread_mutex_unlock(&za_live_lock);
+    return any;
+}
+
+// Every entry, under the lock (fn must not add or remove entries).
+static void za_live_walk(void (*fn)(NvnTexture *t, TexBackend *b, void *arg), void *arg) {
+    pthread_mutex_lock(&za_live_lock);
+    for (int i = 0; i < g_nlive; i++) fn(g_live[i], g_live_b[i], arg);
+    pthread_mutex_unlock(&za_live_lock);
+}
+
+static int za_live_count(void) {
+    pthread_mutex_lock(&za_live_lock);
+    int n = g_nlive;
+    pthread_mutex_unlock(&za_live_lock);
+    return n;
+}
diff -ruN a/runtime/nvn/za_texguard_api_r28a.h b/runtime/nvn/za_texguard_api_r28a.h
--- a/runtime/nvn/za_texguard_api_r28a.h	1970-01-01 02:00:00.000000000 +0200
+++ b/runtime/nvn/za_texguard_api_r28a.h	2026-10-30 14:50:09.306198220 +0200
@@ -0,0 +1,24 @@
+// r28a texfix (port/runtime-texfix): an NvnTexture's lifetime guard - the values, the check, the [za-texguard] sites.
+// Included by nvn.h right after NvnTexture (whose za_guard field it reads); host tests include it after a mirror of it.
+// za_guard is NVN_TEX_LIVE from nvnTextureInitialize to nvnTextureFinalize, then NVN_TEX_DEAD while objects.c keeps the
+// finalized object in quarantine (za_texquarantine_r28a.h). Anything else - memory freed and reused, a pointer that was
+// never a texture - is not live either. Checked where a texture pointer the runtime did not just look up arrives: the
+// registration of a backend (textures.c), recorded command lists (exec.c), the present (device.c), the video thread's
+// upload, texture pool registration and a second finalize (objects.c). Never per draw.
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+
+#define NVN_TEX_LIVE 0x5A54584Cu  // 'ZTXL'
+#define NVN_TEX_DEAD 0xDEAD7E57u
+
+static inline bool nvn_tex_live(const NvnTexture *t) { return t && t->za_guard == NVN_TEX_LIVE; }
+
+// [za-texguard] sites (za_texguard_r28a.h names them)
+enum { ZA_TG_REGISTER, ZA_TG_SET_RT, ZA_TG_PASS, ZA_TG_CLEAR_TEXTURE, ZA_TG_COPY_TO_TEX, ZA_TG_COPY_FROM_TEX,
+       ZA_TG_COPY_TEX, ZA_TG_PRESENT, ZA_TG_UPLOAD_RGBA, ZA_TG_POOL_REGISTER, ZA_TG_FINALIZE_AGAIN, ZA_TG_LIVE_LIST,
+       ZA_TG_SITES };
+// The operation was refused; reported once per (site, caller), counted always. detail: the guard word (live-list:
+// the backend's reg); caller: a return address, or NULL where the site alone says where.
+void za_texguard_hit(int site, const void *tex, uint32_t detail, const void *caller);
+void za_texguard_frame(uint64_t frame);  // (device.c, once per presented frame: the counts now and then)
diff -ruN a/runtime/nvn/za_texquarantine_r28a.h b/runtime/nvn/za_texquarantine_r28a.h
--- a/runtime/nvn/za_texquarantine_r28a.h	1970-01-01 02:00:00.000000000 +0200
+++ b/runtime/nvn/za_texquarantine_r28a.h	2026-10-30 14:50:09.322198165 +0200
@@ -0,0 +1,25 @@
+// r28a texfix (port/runtime-texfix): a finalized NvnTexture is poisoned (za_guard = NVN_TEX_DEAD) and kept for the next
+// ZA_TEX_QUARANTINE finalizations before free(), so a stale pointer to it - in the executor's state, a recorded command
+// list, a guest copy of the texture object - meets the poison, deterministically, instead of memory already reused by
+// another object (r28-play's crash: such memory read back as backend 0x2). The newest pointer pushes the oldest out.
+// Callers serialize (nvnTextureFinalize holds exec_lock). 4096 x 200 bytes: ~800 KB at most.
+// Included once by objects.c; host-tested (port/runtime-texfix/test).
+#pragma once
+#include <stdint.h>
+#include <stdlib.h>
+
+#ifndef ZA_TEX_QUARANTINE
+#define ZA_TEX_QUARANTINE 4096
+#endif
+
+static void *za_quar[ZA_TEX_QUARANTINE];
+static unsigned za_quar_next;
+static uint64_t za_quar_total;
+
+static void za_quarantine_push(void *p) {
+    void *oldest = za_quar[za_quar_next];
+    za_quar[za_quar_next] = p;
+    za_quar_next = (za_quar_next + 1) % ZA_TEX_QUARANTINE;
+    za_quar_total++;
+    free(oldest);  // (NULL until the ring has filled once)
+}
