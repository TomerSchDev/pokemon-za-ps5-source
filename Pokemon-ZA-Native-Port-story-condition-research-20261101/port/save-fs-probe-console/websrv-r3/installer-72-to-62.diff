+class BundleTransferLease:
+    """Bound FIFO checks independently of small TCP receive fragment sizes."""
+    def __init__(self, board, agent, ticket, token, clock=None):
+        self.board,self.agent,self.ticket,self.token=board,agent,ticket,token
+        self.clock=clock or time.monotonic
+        self.last_check=float('-inf');self.last_heartbeat=self.clock()
+
+    def check(self):
+        now=self.clock()
+        # FTP can split a 1 MiB read into many tiny callbacks. Re-reading and
+        # canonicalizing the whole board for every fragment stalls large files.
+        # Poll at least twice a second; all write/rename gates still check live.
+        if now-self.last_check >= .5:
+            self.board.check(self.agent,self.ticket,self.token)
+            self.last_check=now
+        if now-self.last_heartbeat >= 20:
+            self.board.heartbeat(self.agent,self.ticket,self.token)
+            self.last_heartbeat=now
+
+
